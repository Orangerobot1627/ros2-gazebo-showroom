<?xml version="1.0"?>
<robot name="showroom_guide_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- ROS-side kinematic model. Gazebo physics lives in the SDF xacro next
       to this file. Dimensions intentionally match the Stage guide robot. -->
  <xacro:include filename="$(find showroom_description)/urdf/materials.xacro"/>

  <xacro:property name="body_length" value="0.62"/>
  <xacro:property name="body_width" value="0.48"/>
  <xacro:property name="body_height" value="0.38"/>
  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width" value="0.045"/>
  <xacro:property name="wheel_separation" value="0.40"/>

  <link name="base_footprint"/>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.04 0 0.19" rpy="0 0 0"/>
      <mass value="22.5"/>
      <inertia ixx="0.50" ixy="0" ixz="0" iyy="0.78" iyz="0" izz="0.95"/>
    </inertial>
    <collision>
      <origin xyz="-0.04 0 0.19" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="-0.04 0 0.19" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="showroom_blue"/>
    </visual>
    <visual>
      <origin xyz="-0.08 0 0.43" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.10"/>
      </geometry>
      <material name="showroom_dark_blue"/>
    </visual>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="drive_wheel" params="side sign">
    <link name="${side}_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.75"/>
        <inertia ixx="0.0014" ixy="0" ixz="0" iyy="0.0024" iyz="0" izz="0.0014"/>
      </inertial>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="showroom_black"/>
      </visual>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${sign * wheel_separation / 2.0} ${wheel_radius}" rpy="${-pi / 2.0} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel side="left" sign="1"/>
  <xacro:drive_wheel side="right" sign="-1"/>

  <link name="base_scan">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.06"/>
      </geometry>
      <material name="showroom_lidar"/>
    </visual>
  </link>
  <joint name="base_scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="0.18 0 0.50" rpy="0 0 0"/>
  </joint>
</robot>
